# Quality Team: architect + implementer + reviewer + tester + final-reviewer
# Focus on high quality with multiple review layers

[team.quality]
leader_agent = opencode
worker_agent = codex
worker_agent_pool = codex
max_active_workers = 1
roles = architect,implementer,reviewer,tester,final-reviewer

[team.quality.role.architect]
name = Architect
description = Design technical approach and ensure scalability.
success = design is testable and addresses edge cases

[team.quality.role.implementer]
name = Implementer
description = Implement code with focus on correctness and maintainability.
success = code is clean, tested, and follows patterns

[team.quality.role.reviewer]
name = Reviewer
description = First review for correctness, security, and quality.
success = critical issues identified and fixed

[team.quality.role.tester]
name = Tester
description = Run comprehensive tests including edge cases.
success = all tests pass and edge cases are covered

[team.quality.role.final-reviewer]
name = Final Reviewer
description = Final review before commit. Verify all issues are addressed.
success = code is production-ready
