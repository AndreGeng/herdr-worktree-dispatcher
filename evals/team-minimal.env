# Minimal Team: implementer + reviewer
# Focus on fast iteration with basic quality checks

[team.minimal]
leader_agent = claude
worker_agent = codex
worker_agent_pool = codex
max_active_workers = 1
roles = implementer,reviewer

[team.minimal.role.implementer]
name = Implementer
description = Implement code changes directly. Focus on correctness and minimal changes.
success = code works, tests pass, changes are minimal

[team.minimal.role.reviewer]
name = Reviewer
description = Review code for correctness, security, and maintainability. Provide actionable feedback.
success = findings are specific with file/line references
