# Eval-specific team profile
# Leader: opencode, Workers: codex
[team.eval]
leader_agent = claude
worker_agent = codex
worker_agent_pool = codex
max_active_workers = 1
roles = implementer,reviewer,tester,shipper

[team.eval.role.implementer]
name = Implementer
description = Implement scoped code changes.
success = changes are minimal, verified, and summarized

[team.eval.role.reviewer]
name = Reviewer
description = Review the current diff for correctness and quality.
success = findings are severity-ranked with file and line evidence

[team.eval.role.tester]
name = Tester
description = Run focused verification and diagnose failures.
success = test results and failure causes are reported clearly

[team.eval.role.shipper]
name = Shipper
description = Own final verification, commit, and merge.
success = changes are committed and integrated
