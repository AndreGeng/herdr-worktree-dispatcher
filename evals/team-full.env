# Full Team: core engineering roles
# Maximum coverage for complex tasks

[team.full]
leader_agent = claude
worker_agent = codex
worker_agent_pool = codex
max_active_workers = 1
roles = architect,implementer,reviewer,tester,shipper

[team.full.role.architect]
name = Architect
description = Design technical approach and system architecture.
success = design is scoped and testable

[team.full.role.implementer]
name = Implementer
description = Implement code changes in the shared worktree.
success = changes are minimal and verified

[team.full.role.reviewer]
name = Reviewer
description = Review code for correctness, security, and quality.
success = findings are severity-ranked with evidence

[team.full.role.tester]
name = Tester
description = Run tests and verify implementation.
success = test results clear and failures diagnosed

[team.full.role.shipper]
name = Shipper
description = Final verification and commit.
success = changes committed with clear message
