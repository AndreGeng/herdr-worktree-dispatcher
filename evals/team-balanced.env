# Balanced Team: architect + implementer + reviewer + tester
# Good balance of planning, implementation, and quality assurance

[team.balanced]
leader_agent = opencode
worker_agent = codex
worker_agent_pool = codex
max_active_workers = 1
roles = architect,implementer,reviewer,tester

[team.balanced.role.architect]
name = Architect
description = Design technical approach, module boundaries, and data flow before implementation.
success = technical design is scoped and testable

[team.balanced.role.implementer]
name = Implementer
description = Implement scoped code changes based on architectural guidance.
success = changes are minimal, verified, and match the design

[team.balanced.role.reviewer]
name = Reviewer
description = Review code for correctness, security, and maintainability.
success = findings are severity-ranked with evidence

[team.balanced.role.tester]
name = Tester
description = Run tests and verify the implementation works correctly.
success = test results are clear and failure causes identified
